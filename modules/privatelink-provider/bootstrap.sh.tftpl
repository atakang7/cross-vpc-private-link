#!/usr/bin/env bash
set -euo pipefail

# Amazon Linux 2023 includes Python 3; private subnets have no NAT/IGW.
cat > /opt/hello_world.py <<'PY'
import http.server
import json
from datetime import datetime, timezone

class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        payload = json.dumps({
            "message": "Hello from provider",
            "ts": datetime.now(timezone.utc).isoformat()
        }).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

http.server.ThreadingHTTPServer(("0.0.0.0", ${port}), Handler).serve_forever()
PY

chmod 0644 /opt/hello_world.py
cat > /etc/systemd/system/hello.service <<'SERVICE'
[Unit]
Description=PrivateLink hello demo
After=network.target
[Service]
Type=simple
User=nobody
ExecStart=/usr/bin/python3 /opt/hello_world.py
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable --now hello.service
